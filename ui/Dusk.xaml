     <Grid Height="3"><Border Background="#33FFFFFF" CornerRadius="1.5"/><Border x:Name="BatteryCaseBar" Width="0" HorizontalAlignment="Left" Background="#F2F2F2" CornerRadius="1.5"/></Grid>
