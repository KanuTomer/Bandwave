<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Name="Root" RequestedTheme="Dark">
 <Grid.Resources>
  <ResourceDictionary>
   <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Default">
     <SolidColorBrush x:Key="Veil" Color="#12FFFFFF"/>
     <SolidColorBrush x:Key="RuleBrush" Color="#1FFFFFFF"/>
     <SolidColorBrush x:Key="SoftText" Color="#D1F2F2F2"/>
     <!-- Glass: translucent, over the stage's own frosted waves (0.5.18). -->
     <SolidColorBrush x:Key="DrawerFill" Color="#B8121212"/>
     <SolidColorBrush x:Key="ToggleButtonBackground" Color="#0DFFFFFF"/>
     <SolidColorBrush x:Key="ToggleButtonBackgroundPointerOver" Color="#1AFFFFFF"/>
     <SolidColorBrush x:Key="ToggleButtonBackgroundPressed" Color="#26FFFFFF"/>
     <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="#33FFFFFF"/>
     <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="#40FFFFFF"/>
     <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="#2BFFFFFF"/>
     <SolidColorBrush x:Key="ToggleButtonForegroundChecked" Color="#F2F2F2"/>
     <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPointerOver" Color="#F2F2F2"/>
     <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPressed" Color="#F2F2F2"/>
     <SolidColorBrush x:Key="ToggleButtonBorderBrush" Color="Transparent"/>
     <SolidColorBrush x:Key="ToggleButtonBorderBrushPointerOver" Color="Transparent"/>
     <SolidColorBrush x:Key="ToggleButtonBorderBrushPressed" Color="Transparent"/>
     <SolidColorBrush x:Key="ToggleButtonBorderBrushChecked" Color="Transparent"/>
     <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedPointerOver" Color="Transparent"/>
     <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedPressed" Color="Transparent"/>
     <SolidColorBrush x:Key="ButtonBackground" Color="#14FFFFFF"/>
     <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#21FFFFFF"/>
     <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#0DFFFFFF"/>
     <SolidColorBrush x:Key="ButtonBorderBrush" Color="Transparent"/>
     <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent"/>
     <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent"/>
    </ResourceDictionary>
    <ResourceDictionary x:Key="HighContrast">
     <SolidColorBrush x:Key="Veil" Color="{ThemeResource SystemColorWindowColor}"/>
     <SolidColorBrush x:Key="RuleBrush" Color="{ThemeResource SystemColorWindowTextColor}"/>
     <SolidColorBrush x:Key="SoftText" Color="{ThemeResource SystemColorWindowTextColor}"/>
     <SolidColorBrush x:Key="DrawerFill" Color="{ThemeResource SystemColorWindowColor}"/>
    </ResourceDictionary>
   </ResourceDictionary.ThemeDictionaries>
   <Style x:Key="BandSlider" TargetType="Slider">
    <Setter Property="IsThumbToolTipEnabled" Value="False"/>
    <Setter Property="Orientation" Value="Vertical"/>
    <Setter Property="Minimum" Value="-10"/>
    <Setter Property="Maximum" Value="10"/>
    <Setter Property="StepFrequency" Value="1"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider">
     <Grid x:Name="SliderContainer" Background="Transparent" HorizontalAlignment="Center" Width="60">
      <VisualStateManager.VisualStateGroups><VisualStateGroup x:Name="CommonStates"><VisualState x:Name="Normal"/><VisualState x:Name="PointerOver"/><VisualState x:Name="Pressed"/><VisualState x:Name="Disabled"><VisualState.Setters><Setter Target="VerticalTemplate.Opacity" Value="0.4"/></VisualState.Setters></VisualState></VisualStateGroup></VisualStateManager.VisualStateGroups>
      <Grid x:Name="VerticalTemplate">
       <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <Rectangle x:Name="VerticalTrackRect" Grid.RowSpan="3" Width="1" Fill="#14FFFFFF"/>
       <Rectangle x:Name="VerticalDecreaseRect" Grid.Row="2" Width="1" Fill="Transparent"/>
       <!-- The visible handle is drawn on the curve itself. This thumb only takes input. -->
       <Thumb x:Name="VerticalThumb" Grid.Row="1" Width="28" Height="28" AutomationProperties.AccessibilityView="Raw"><Thumb.Template><ControlTemplate TargetType="Thumb"><Grid Background="Transparent"/></ControlTemplate></Thumb.Template></Thumb>
      </Grid>
     </Grid>
    </ControlTemplate></Setter.Value></Setter>
   </Style>
  </ResourceDictionary>
 </Grid.Resources>

 <Viewbox x:Name="Haze" Stretch="UniformToFill" IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw">
  <Canvas Width="1280" Height="800">
   <Canvas.Clip><RectangleGeometry Rect="0,0,1280,800"/></Canvas.Clip>
   <Canvas x:Name="GlowHost"/>
   <Image x:Name="Dither" Width="1280" Height="800" Stretch="Fill"/>
  </Canvas>
 </Viewbox>

 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="44"/><RowDefinition Height="*"/></Grid.RowDefinitions>

  <Grid x:Name="TitleArea">
   <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="138"/></Grid.ColumnDefinitions>
   <Button x:Name="BackButton" Width="44" Height="44" Background="Transparent" Visibility="Collapsed" AutomationProperties.Name="Back" CornerRadius="0"><FontIcon Glyph="&#xE72B;" FontSize="14"/></Button>
   <StackPanel x:Name="TitleDrag" Grid.Column="1" Orientation="Horizontal" Spacing="12" Background="Transparent" Padding="20,0,0,0">
    <TextBlock x:Name="TitleText" Text="WF-C710N" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
    <TextBlock x:Name="TitleState" Text="Connected" FontSize="12" Foreground="{ThemeResource SoftText}" VerticalAlignment="Center"/>
   </StackPanel>
   <Button x:Name="UpdateButton" Grid.Column="2" Height="32" Padding="12,0" Margin="0,0,6,0" VerticalAlignment="Center" Visibility="Collapsed" AutomationProperties.Name="Install the update"/>
   <Button x:Name="SettingsButton" Grid.Column="3" Width="44" Height="44" Background="Transparent" AutomationProperties.Name="Settings" CornerRadius="0"><FontIcon Glyph="&#xE713;" FontSize="15"/></Button>
  </Grid>

  <Grid x:Name="MainPage" Grid.Row="1">
   <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <!-- The stage's swap chain covers the whole page, behind the controls, and draws the waves only in
        the Stage row. Covering just the stage left an edge under it that Windows can composite
        differently from the page (hardware overlay planes), seen on the panel as a hard bar under the
        library's glass but never in screenshots (0.5.19). -->
   <SwapChainPanel x:Name="WaveChain" Grid.RowSpan="4" IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw"/>
   <Grid x:Name="Stage" AutomationProperties.AccessibilityView="Raw">
    <Viewbox MaxWidth="548" MaxHeight="197" Margin="16,8" Stretch="Uniform" Opacity="0" IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw">
     <Grid Width="780" Height="280" ColumnSpacing="60">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Grid Width="305" Height="280" HorizontalAlignment="Center" AutomationProperties.Name="Left earbud"><Viewbox x:Name="BudLeft"/></Grid>
      <Grid Grid.Column="1" Width="305" Height="280" HorizontalAlignment="Center" RenderTransformOrigin="0.5,0.5" AutomationProperties.Name="Right earbud"><Grid.RenderTransform><ScaleTransform ScaleX="-1"/></Grid.RenderTransform><Viewbox x:Name="BudRight"/></Grid>
     </Grid>
    </Viewbox>
   </Grid>
   <!-- Shown over the still waves while the earbuds aren't connected, as in Tribit Connect. -->
   <Border x:Name="OfflineCard" Visibility="Collapsed" Opacity="0" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="460" Margin="24" Padding="28,22" CornerRadius="12" Background="#E6101010" BorderBrush="{ThemeResource RuleBrush}" BorderThickness="1">
    <StackPanel Spacing="10">
     <TextBlock x:Name="OfflineTitle" Text="Earbuds not connected" FontFamily="Segoe UI Variable Display" FontWeight="Light" FontSize="24" HorizontalAlignment="Center" AutomationProperties.HeadingLevel="Level2"/>
     <TextBlock x:Name="OfflineBody" FontSize="13" TextWrapping="Wrap" TextAlignment="Center" Foreground="{ThemeResource SoftText}" Text="Take them out of the case and check they're connected to this PC in Bluetooth settings. They take one controller at a time, so close Sony's app on your phone."/>
     <TextBlock x:Name="OfflineSeen" FontSize="12" TextWrapping="Wrap" TextAlignment="Center" Foreground="{ThemeResource SoftText}" Visibility="Collapsed"/>
     <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" Margin="0,6,0,0">
      <Button x:Name="OfflineReconnect" Content="Reconnect" Height="36" Padding="16,0"/>
      <Button x:Name="OfflineBluetooth" Content="Bluetooth settings" Height="36" Padding="16,0"/>
     </StackPanel>
    </StackPanel>
   </Border>

