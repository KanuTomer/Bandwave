    </StackPanel>
   </Grid>

   <Border Grid.Row="2" HorizontalAlignment="Center" Padding="4" CornerRadius="10" Background="{ThemeResource Veil}" Margin="0,0,0,14">
    <Grid x:Name="NoiseHost">
     <Grid.Resources>
      <SolidColorBrush x:Key="ToggleButtonBackground" Color="Transparent"/><SolidColorBrush x:Key="ToggleButtonBackgroundPointerOver" Color="Transparent"/><SolidColorBrush x:Key="ToggleButtonBackgroundPressed" Color="Transparent"/>
      <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="Transparent"/>
      <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="Transparent"/>
      <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="Transparent"/>
     </Grid.Resources>
     <Canvas IsHitTestVisible="False"><Border x:Name="NoisePill" CornerRadius="7" Background="#33FFFFFF"/></Canvas>
     <StackPanel Orientation="Horizontal" Spacing="4">
      <ToggleButton x:Name="NoiseCancelling" Height="48" Padding="20,0" CornerRadius="7">
       <StackPanel Orientation="Horizontal" Spacing="10"><Viewbox x:Name="IconCancelling" Width="22" Height="22"><Canvas Width="24" Height="24"><Path Data="M12 2 A10 10 0 1 1 11.99 2 Z M12 6.5 A5.5 5.5 0 1 1 11.99 6.5 Z M12 10.6 A1.4 1.4 0 1 1 11.99 10.6 Z" Stroke="#F2F2F2" StrokeThickness="1.5"/></Canvas></Viewbox><TextBlock Text="Noise cancelling" VerticalAlignment="Center"/></StackPanel>
      </ToggleButton>
      <ToggleButton x:Name="NoiseAmbient" Height="48" Padding="20,0" CornerRadius="7">
       <StackPanel Orientation="Horizontal" Spacing="10"><Viewbox x:Name="IconAmbient" Width="22" Height="22"><Canvas Width="24" Height="24"><Path Data="M12 10.6 A1.4 1.4 0 1 1 11.99 10.6 Z M7.5 7.5 A6.4 6.4 0 0 0 7.5 16.5 M16.5 7.5 A6.4 6.4 0 0 1 16.5 16.5 M4.2 4.5 A11 11 0 0 0 4.2 19.5 M19.8 4.5 A11 11 0 0 1 19.8 19.5" Stroke="#F2F2F2" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Canvas></Viewbox><TextBlock Text="Ambient" VerticalAlignment="Center"/></StackPanel>
      </ToggleButton>
      <ToggleButton x:Name="NoiseOff" Height="48" Padding="20,0" CornerRadius="7">
       <StackPanel Orientation="Horizontal" Spacing="10"><Viewbox x:Name="IconOff" Width="22" Height="22"><Canvas Width="24" Height="24"><Path Data="M3 12 H21" Stroke="#F2F2F2" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Canvas></Viewbox><TextBlock Text="Off" VerticalAlignment="Center"/></StackPanel>
      </ToggleButton>
     </StackPanel>
    </Grid>
   </Border>

   <Grid Grid.Row="3" Margin="28,0,28,22" ColumnSpacing="8">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <ScrollViewer x:Name="HomeBankScroll" HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Auto" VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled">
     <Grid x:Name="BankHost" HorizontalAlignment="Left">
      <Grid.Resources><SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="#0DFFFFFF"/><SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="#1AFFFFFF"/><SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="#0DFFFFFF"/></Grid.Resources>
      <Canvas IsHitTestVisible="False"><Border x:Name="BankPill" CornerRadius="8" Background="#2BFFFFFF"/></Canvas>
      <Grid x:Name="Bank" ColumnSpacing="6"/>
     </Grid>
    </ScrollViewer>
    <Button x:Name="AllButton" Grid.Column="1" Width="92" Height="96" CornerRadius="8" AutomationProperties.Name="All EQs">
     <StackPanel Spacing="8"><FontIcon Glyph="&#xE80A;" FontSize="16"/><TextBlock x:Name="AllLabel" FontSize="13" HorizontalAlignment="Center"/></StackPanel>
    </Button>
   </Grid>
  </Grid>

  <Grid x:Name="EqPage" Grid.Row="1" Visibility="Collapsed">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid x:Name="GuideHeader" Margin="28,8,28,0" Visibility="Collapsed">
    <TextBlock Text="Find your EQ" FontFamily="Segoe UI Variable Display" FontWeight="Light" FontSize="28" Padding="0,6" VerticalAlignment="Center"/>
    <Button x:Name="GuideCancelButton" Content="Cancel" Height="40" Padding="16,0" HorizontalAlignment="Right" Background="Transparent"/>
   </Grid>
   <Grid x:Name="EqHeader" Margin="28,8,28,0" ColumnSpacing="8">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <TextBox x:Name="ProfileName" FontFamily="Segoe UI Variable Display" FontWeight="Light" FontSize="28" Background="Transparent" BorderThickness="0" Padding="0,2" MaxLength="32" HorizontalAlignment="Stretch" MinWidth="200" AutomationProperties.Name="EQ name"/>
    <TextBlock x:Name="EditedText" Grid.Column="1" FontSize="12" Foreground="{ThemeResource SoftText}" VerticalAlignment="Center" Margin="0,0,8,0" Visibility="Collapsed"/>
    <Button x:Name="CompareButton" Grid.Column="2" Height="40" Padding="14,0" AutomationProperties.Name="Hold to hear how it was">
     <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE8AB;" FontSize="14"/><TextBlock x:Name="CompareLabel" Text="Hold to compare"/></StackPanel>
    </Button>
    <Button x:Name="EditorUndoButton" Grid.Column="3" Height="40" Padding="14,0" AutomationProperties.Name="Undo">
     <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE7A7;" FontSize="14"/><TextBlock Text="Undo"/></StackPanel>
    </Button>
    <Button x:Name="EqMoreButton" Grid.Column="4" Width="40" Height="40" AutomationProperties.Name="More EQ actions"><FontIcon Glyph="&#xE712;" FontSize="16"/>
     <Button.Flyout><MenuFlyout>
      <MenuFlyoutItem x:Name="ResetAction" Text="Reset to how it was"/>
      <MenuFlyoutItem x:Name="FlatAction" Text="Make flat"/>
      <MenuFlyoutItem x:Name="DuplicateAction" Text="Duplicate"/>
      <MenuFlyoutSeparator/>
      <MenuFlyoutItem x:Name="DeleteAction" Text="Delete"/>
     </MenuFlyout></Button.Flyout>
    </Button>
   </Grid>
   <Grid x:Name="CurveArea" Grid.Row="1" Margin="104,16,28,0" MinHeight="140">
    <Border Background="#05FFFFFF" BorderBrush="#12FFFFFF" BorderThickness="1" CornerRadius="8"/>
    <SwapChainPanel x:Name="CurveChain" Margin="8" IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw"/>
    <Rectangle x:Name="CurveGlow" IsHitTestVisible="False" Visibility="Collapsed" AutomationProperties.AccessibilityView="Raw"/>
    <Grid x:Name="BandGrid" Margin="44,12,20,12"/>
    <Canvas x:Name="CurveCanvas" Margin="12" IsHitTestVisible="False"/>
   </Grid>
   <Grid x:Name="BandValues" Grid.Row="2" Margin="148,10,48,22"/>
   <!-- Clear Bass (0.5.18): Sony's bass processing, not a sixth EQ point, so it is its own glowing
        column beside the graph, at the bass end. Drag it up or down; the glow grows from 0. -->
   <Grid x:Name="BassRow" Grid.Row="1" Grid.RowSpan="2" Width="64" HorizontalAlignment="Left" Margin="28,16,0,22">
    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border Background="#05FFFFFF" BorderBrush="#12FFFFFF" BorderThickness="1" CornerRadius="8"/>
    <Grid x:Name="BassTrack" Margin="0,12">
     <Rectangle x:Name="BassZero" Height="1" Margin="14,0" VerticalAlignment="Top" Fill="#29FFFFFF" IsHitTestVisible="False"/>
     <Border x:Name="BassGlow" Width="18" HorizontalAlignment="Center" VerticalAlignment="Top" IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw"/>
     <Border x:Name="BassKnob" Width="24" Height="10" CornerRadius="5" HorizontalAlignment="Center" VerticalAlignment="Top" Background="#0A0A0A" BorderBrush="#F2F2F2" BorderThickness="2" IsHitTestVisible="False"/>
     <Slider x:Name="BassSlider" Style="{StaticResource BandSlider}" HorizontalAlignment="Center" VerticalAlignment="Stretch" AutomationProperties.Name="Clear Bass"/>
    </Grid>
    <StackPanel Grid.Row="1" Spacing="2" Margin="0,10,0,0" HorizontalAlignment="Center">
     <TextBlock x:Name="BassValue" FontFamily="Segoe UI Variable Display" FontWeight="Light" FontSize="26" HorizontalAlignment="Center"/>
     <TextBlock x:Name="BassLabel" Text="Clear Bass" FontSize="12" HorizontalAlignment="Center"/>
    </StackPanel>
   </Grid>
   <Grid x:Name="EqBankRow" Grid.Row="4" Margin="28,14,28,22" ColumnSpacing="8" Visibility="Collapsed">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <ScrollViewer x:Name="EditorBankScroll" HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Auto" VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled">
     <Grid x:Name="EqBankHost" HorizontalAlignment="Left">
      <Grid.Resources><SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="#0DFFFFFF"/><SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="#1AFFFFFF"/><SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="#0DFFFFFF"/></Grid.Resources>
      <Canvas IsHitTestVisible="False"><Border x:Name="EqPill" CornerRadius="8" Background="#2BFFFFFF"/></Canvas>
      <Grid x:Name="EqBank" ColumnSpacing="6"/>
     </Grid>
    </ScrollViewer>
    <Button x:Name="EditorNewButton" Grid.Column="1" Width="92" Height="96" CornerRadius="8" AutomationProperties.Name="New EQ"><StackPanel Spacing="8"><FontIcon Glyph="&#xE710;" FontSize="16"/><TextBlock Text="New EQ" FontSize="13" HorizontalAlignment="Center"/></StackPanel></Button>
    <Button x:Name="EqAllButton" Grid.Column="2" Width="92" Height="96" CornerRadius="8" AutomationProperties.Name="All EQs">
     <StackPanel Spacing="8"><FontIcon Glyph="&#xE80A;" FontSize="16"/><TextBlock x:Name="EqAllLabel" FontSize="13" HorizontalAlignment="Center"/></StackPanel>
    </Button>
    <TextBlock x:Name="EqNote" Visibility="Collapsed"/>
   </Grid>
   <!-- Find your EQ: listening rounds below the same big curve. -->
   <Grid x:Name="GuidePanel" Grid.Row="3" Grid.RowSpan="2" Margin="28,0,28,22" RowSpacing="14" Visibility="Collapsed">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid>
     <TextBlock x:Name="GuideStep" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
     <StackPanel x:Name="GuideDots" Orientation="Horizontal" Spacing="2" HorizontalAlignment="Right" VerticalAlignment="Center"/>
    </Grid>
    <Grid x:Name="GuideContent" Grid.Row="1" Height="112">
     <Grid x:Name="GuideChoiceHost" HorizontalAlignment="Center" VerticalAlignment="Top">
      <Grid.Resources><SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="#0DFFFFFF"/><SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="#1AFFFFFF"/><SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="#0DFFFFFF"/><SolidColorBrush x:Key="ToggleButtonForegroundChecked" Color="#F2F2F2"/><SolidColorBrush x:Key="ToggleButtonForegroundCheckedPointerOver" Color="#FFFFFF"/><SolidColorBrush x:Key="ToggleButtonForegroundCheckedPressed" Color="#F2F2F2"/></Grid.Resources>
      <Canvas IsHitTestVisible="False"><Border x:Name="GuidePill" CornerRadius="8" Background="#2BFFFFFF"/></Canvas>
      <!-- Five sounds, numbered like Sony's. Round 2 puts the first pick in the middle; the result
           uses the first two as After and Before. Labels are set in sync_guide. -->
      <StackPanel x:Name="GuideOptions" Orientation="Horizontal" Spacing="8">
       <ToggleButton x:Name="GuideOption0" Width="128" Height="112" CornerRadius="8" Padding="16,10" HorizontalContentAlignment="Left" VerticalContentAlignment="Bottom"><TextBlock x:Name="GuideLabel0" FontFamily="Segoe UI Variable Display" FontWeight="Light" FontSize="24"/></ToggleButton>
       <ToggleButton x:Name="GuideOption1" Width="128" Height="112" CornerRadius="8" Padding="16,10" HorizontalContentAlignment="Left" VerticalContentAlignment="Bottom"><TextBlock x:Name="GuideLabel1" FontFamily="Segoe UI Variable Display" FontWeight="Light" FontSize="24"/></ToggleButton>
       <ToggleButton x:Name="GuideOption2" Width="128" Height="112" CornerRadius="8" Padding="16,10" HorizontalContentAlignment="Left" VerticalContentAlignment="Bottom"><TextBlock x:Name="GuideLabel2" FontFamily="Segoe UI Variable Display" FontWeight="Light" FontSize="24"/></ToggleButton>
       <ToggleButton x:Name="GuideOption3" Width="128" Height="112" CornerRadius="8" Padding="16,10" HorizontalContentAlignment="Left" VerticalContentAlignment="Bottom"><TextBlock x:Name="GuideLabel3" FontFamily="Segoe UI Variable Display" FontWeight="Light" FontSize="24"/></ToggleButton>
       <ToggleButton x:Name="GuideOption4" Width="128" Height="112" CornerRadius="8" Padding="16,10" HorizontalContentAlignment="Left" VerticalContentAlignment="Bottom"><TextBlock x:Name="GuideLabel4" FontFamily="Segoe UI Variable Display" FontWeight="Light" FontSize="24"/></ToggleButton>
      </StackPanel>
     </Grid>
    </Grid>
    <Grid Grid.Row="2" ColumnSpacing="8">
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <HyperlinkButton x:Name="GuideRetryButton" Content="Start again" VerticalAlignment="Center" Visibility="Collapsed"/>
     <Button x:Name="GuideBackButton" Grid.Column="1" Content="Back" Height="40" Padding="16,0"/>
     <Button x:Name="GuideNextButton" Grid.Column="2" Content="Next" Height="40" Padding="20,0" MinWidth="96"/>
    </Grid>
   </Grid>
  </Grid>

  <Grid x:Name="SettingsPage" Grid.Row="1" Visibility="Collapsed">
   <ScrollViewer x:Name="SettingsScroll" Padding="48,0,48,16">
    <Grid x:Name="SettingsBody" MinHeight="640">
     <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <Grid.ColumnDefinitions><ColumnDefinition x:Name="SettingsLeftColumn" Width="370"/><ColumnDefinition x:Name="SettingsMiddleColumn" Width="*"/><ColumnDefinition x:Name="SettingsRightColumn" Width="370"/></Grid.ColumnDefinitions>
     <StackPanel x:Name="SettingsLeft" Spacing="26" VerticalAlignment="Center"/>
     <Grid x:Name="SettingsBuds" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center" ColumnSpacing="10" Margin="10,0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <Viewbox x:Name="SettingsBudLeft" Width="200" Height="184"/>
      <Viewbox x:Name="SettingsBudRight" Grid.Column="1" Width="200" Height="184" RenderTransformOrigin="0.5,0.5"><Viewbox.RenderTransform><ScaleTransform ScaleX="-1"/></Viewbox.RenderTransform></Viewbox>
     </Grid>
     <StackPanel x:Name="SettingsRight" Grid.Column="2" Spacing="26" VerticalAlignment="Center"/>
     <!-- Disconnected: none of the earbuds' settings can be changed, so they are hidden and this says why (0.6.2). -->
     <TextBlock x:Name="SettingsOffline" Grid.ColumnSpan="3" Text="Connect your earbuds to change their settings." FontSize="15" Foreground="{ThemeResource SoftText}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,260,0,0" Visibility="Collapsed"/>
     <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8" Margin="0,18,0,0">
      <Button x:Name="ConnectionsButton" Content="Connections" Height="44" Padding="18,0"/>
      <Button x:Name="AppButton" Content="App and widget" Height="44" Padding="18,0"/>
      <Button x:Name="AboutButton" Content="About" Height="44" Padding="18,0"/>
     </StackPanel>
    </Grid>
   </ScrollViewer>
   <Canvas x:Name="SettingsLines" IsHitTestVisible="False"/>
  </Grid>
 </Grid>

 <Grid x:Name="Drawer" Visibility="Collapsed" Margin="0,84,0,0" Background="{ThemeResource DrawerFill}" CornerRadius="14,14,0,0" BorderThickness="0,1,0,0" BorderBrush="{ThemeResource RuleBrush}">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Grid Margin="28,18,28,10" ColumnSpacing="10">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="240"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <TextBlock Text="Your EQs" FontFamily="Segoe UI Variable Display" FontWeight="Light" FontSize="28" VerticalAlignment="Center"/>
   <TextBox x:Name="LibrarySearch" Grid.Column="1" PlaceholderText="Search" VerticalAlignment="Center" AutomationProperties.Name="Search EQs"/>
   <Button x:Name="NewButton" Grid.Column="2" Height="40"><StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="New EQ"/><FontIcon Glyph="&#xE70D;" FontSize="10"/></StackPanel>
    <Button.Flyout><MenuFlyout Placement="BottomEdgeAlignedRight">
     <MenuFlyoutItem x:Name="NewGuideAction" Text="Find your EQ (listen and pick)"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8D6;"/></MenuFlyoutItem.Icon></MenuFlyoutItem>
     <MenuFlyoutItem x:Name="NewFlatAction" Text="Start flat"/>
     <MenuFlyoutItem x:Name="NewCopyAction" Text="Copy of current EQ"/>
    </MenuFlyout></Button.Flyout></Button>
   <Button x:Name="CloseDrawerButton" Grid.Column="3" Width="40" Height="40" AutomationProperties.Name="Close"><FontIcon Glyph="&#xE70D;" FontSize="13"/></Button>
  </Grid>
  <ScrollViewer x:Name="LibraryScroll" Grid.Row="1" Padding="28,0,28,20">
   <Canvas x:Name="LibraryCanvas" VerticalAlignment="Top" Margin="0,4,0,0"/>
  </ScrollViewer>
 </Grid>
</Grid>
