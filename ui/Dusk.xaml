    </StackPanel>
    <StackPanel x:Name="BatteryRight" Grid.Column="2" Spacing="3" Width="72" AutomationProperties.Name="Right earbud battery">
     <TextBlock x:Name="BatteryRightText" Text="—" FontFamily="Segoe UI Variable Display" FontWeight="Light" FontSize="32" HorizontalAlignment="Center"/>
     <Grid Height="3"><Border Background="#33FFFFFF" CornerRadius="1.5"/><Border x:Name="BatteryRightBar" Width="0" HorizontalAlignment="Left" Background="#F2F2F2" CornerRadius="1.5"/></Grid>
